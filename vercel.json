{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/sync-email-mailboxes",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/organization-backups",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/platform-trial-reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/process-email-queue",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "src/app/api/company/document-email/send/route.ts": {
      "memory": 3008,
      "maxDuration": 120
    },
    "src/app/api/company/document-email/route.ts": {
      "memory": 3008,
      "maxDuration": 120
    },
    "src/app/api/company/backups/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/company/backups/[backupId]/restore/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/company/backups/[backupId]/run/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/organization-backups/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/backups/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/sync-email-mailboxes/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/company/email-mailbox/accounts/[accountId]/sync/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/company/email-mailbox/messages/send/route.ts": {
      "maxDuration": 120
    }
  }
}
